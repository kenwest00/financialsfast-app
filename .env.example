# FinancialsFast — Environment Variables
# Copy to .env.local and fill in values

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price IDs — one per product (create in Stripe Dashboard)
# P&L Statement — $97.00 USD, one-time
STRIPE_PRICE_PNL=your_stripe_pnl_price_id_here
# Balance Sheet — $97.00 USD, one-time
STRIPE_PRICE_BS=your_stripe_bs_price_id_here
# Cash Flow Projection — $97.00 USD, one-time
STRIPE_PRICE_CASHFLOW=your_stripe_cashflow_price_id_here
# Complete Financial Package (bundle) — $247.00 USD, one-time
STRIPE_PRICE_BUNDLE=your_stripe_bundle_price_id_here

# Public keys (accessible in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Anthropic (for AI classification pipeline)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Production overrides (set in Vercel Dashboard):
# NEXT_PUBLIC_BASE_URL=https://www.financialsfast.com
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
